# Copy this file to .env.local and fill in your values.
# .env.local is never committed to git.

# ------------------------------------------------------------------
# Slack — Nova monitors #bot_announcements for new partner deals
# Bot token: api.slack.com/apps → OAuth & Permissions → Bot User OAuth Token
# Required OAuth scopes: channels:history, channels:read, groups:history,
#                        groups:read, chat:write
# ------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret — verifies that webhook events are genuinely from Slack
# api.slack.com/apps → Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------
# Linear — Nova reads tickets and epics for content opportunities
# Get your API key at: Linear → Settings → API → Personal API keys
# ------------------------------------------------------------------
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------
# Anthropic — Nova uses Claude to research partners and decide on announcements
# Get your API key at: console.anthropic.com → API Keys
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------
# Notion — Nova maintains the content calendar as a Notion database
#
# 1. Create an integration at notion.so/my-integrations (Internal, read+write)
# 2. Create a database with these properties:
#      Name        — Title  (built-in)
#      Date        — Date
#      Week        — Number
#      Type        — Select  (product-launch | partner-launch | thought-leadership | other)
#      Channels    — Select  (All channels | Email + LinkedIn | Email + X |
#                             X + LinkedIn | Email only | X only | LinkedIn only)
#      Description — Text
#      Source      — Select  (Nova | Linear)
# 3. Open the database page → ••• menu → Connections → add your integration
# 4. Copy the database ID from the URL:
#      notion.so/<workspace>/<DATABASE_ID>?v=...
# ------------------------------------------------------------------
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
